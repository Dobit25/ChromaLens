# Local environments and secrets
.venv/
venv/
env/
.env
.env.*
!.env.example

# Python caches and test/tool output
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Packaging output
*.egg-info/
build/
dist/

# Model weights and exported runtimes
*.ckpt
*.onnx
*.pb
*.pth
*.pt
*.safetensors
*.task
*.tflite
models/*
!models/README.md

# Generated or private media/evaluation output
generated/
outputs/
# T09 keeps small curated text results in Git. Raw media, arrays, private
# footage, and bulk evidence stay under the ignored artifacts/t09/ tree.
evaluation/results/**
!evaluation/results/README.md
!evaluation/results/curated/
!evaluation/results/curated/**/
!evaluation/results/curated/**/*.csv
!evaluation/results/curated/**/*.json
!evaluation/results/curated/**/*.md
datasets/

# Editors and operating-system metadata
.idea/
.vscode/
.DS_Store
Thumbs.db
