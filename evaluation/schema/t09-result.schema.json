{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromalens.local/schema/t09-result-1.0.0.json",
  "title": "ChromaLens T09 curated evaluation result",
  "description": "Frozen machine-readable contract for protocol 1.0.0. Validate metric names and units against metric_registry.json in addition to this structural schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "schema_version",
    "metric_registry_version",
    "result_id",
    "workstream",
    "result_status",
    "git_commit",
    "created_at_utc",
    "operator",
    "environment",
    "cases",
    "configuration",
    "metrics",
    "artifacts",
    "commands",
    "failure_cases",
    "limitations",
    "responsible_ai"
  ],
  "properties": {
    "protocol_version": {"const": "1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "metric_registry_version": {"const": "1.0.0"},
    "result_id": {
      "type": "string",
      "pattern": "^t09-[a-z0-9]+(?:-[a-z0-9]+)*-[0-9]{8}t[0-9]{6}z$"
    },
    "workstream": {
      "enum": [
        "end_to_end",
        "segmentation",
        "color_science",
        "performance_responsible_ai"
      ]
    },
    "result_status": {"enum": ["COMPLETE", "PARTIAL", "INVALID", "NOT_RUN"]},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "operator": {"$ref": "#/$defs/operator"},
    "environment": {"$ref": "#/$defs/environment"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case_result"}
    },
    "configuration": {"$ref": "#/$defs/configuration"},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/metric"}
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/command"}
    },
    "failure_cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/failure_case"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "responsible_ai": {"$ref": "#/$defs/responsible_ai"},
    "notes": {"type": "string"}
  },
  "$defs": {
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "identifier"],
      "properties": {
        "role": {
          "enum": ["coordinator", "segmentation_evaluator", "color_evaluator", "performance_evaluator"]
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "description": "Team role or non-sensitive stable identifier; do not store participant identity."
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_role",
        "declared_demo_hardware",
        "manufacturer",
        "model",
        "operating_system",
        "cpu",
        "physical_core_count",
        "logical_processor_count",
        "ram_gib",
        "gpu",
        "npu",
        "camera_or_source",
        "python_version",
        "package_versions",
        "lock_sha256",
        "backend_name",
        "backend_device",
        "source_kind",
        "source_resolution",
        "render_resolution",
        "display_mode",
        "warmup_seconds",
        "measurement_seconds"
      ],
      "properties": {
        "host_role": {"enum": ["development", "demo"]},
        "declared_demo_hardware": {"type": "boolean"},
        "manufacturer": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "operating_system": {"type": "string", "minLength": 1},
        "cpu": {"type": "string", "minLength": 1},
        "physical_core_count": {"type": "integer", "minimum": 1},
        "logical_processor_count": {"type": "integer", "minimum": 1},
        "ram_gib": {"type": "number", "exclusiveMinimum": 0},
        "gpu": {"type": ["string", "null"]},
        "npu": {"type": ["string", "null"]},
        "camera_or_source": {"type": "string", "minLength": 1},
        "python_version": {"const": "3.10.20"},
        "package_versions": {
          "type": "object",
          "minProperties": 4,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "backend_name": {"type": "string", "minLength": 1},
        "backend_device": {"type": "string", "minLength": 1},
        "source_kind": {"enum": ["webcam", "video", "image", "generated", "inline_synthetic", "manual_baseline"]},
        "source_resolution": {"$ref": "#/$defs/resolution"},
        "render_resolution": {"$ref": "#/$defs/resolution"},
        "display_mode": {"enum": ["gui", "headless", "not_applicable"]},
        "warmup_seconds": {"type": "number", "minimum": 0},
        "measurement_seconds": {"type": "number", "minimum": 0},
        "external_measurement_apparatus": {"type": ["string", "null"]}
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "status", "fixture_id", "artifact_ids", "reason"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
        "status": {"enum": ["COMPLETE", "PARTIAL", "INVALID", "NOT_RUN"]},
        "fixture_id": {"type": "string", "minLength": 1},
        "artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
        },
        "reason": {"type": "string"}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cvd_profile", "severity", "thresholds"],
      "properties": {
        "cvd_profile": {"enum": ["protan", "deutan", "tritan", "not_applicable"]},
        "severity": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "thresholds": {
          "type": "object",
          "additionalProperties": {"type": ["number", "integer", "boolean", "string", "null"]}
        },
        "random_seed": {"type": ["integer", "null"]},
        "settings": {
          "type": "object",
          "additionalProperties": {"type": ["number", "integer", "boolean", "string", "null"]}
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "aggregation",
        "unit",
        "status",
        "value",
        "case_ids",
        "threshold_id",
        "threshold_result",
        "reason",
        "method"
      ],
      "properties": {
        "name": {
          "enum": [
            "processed_fps",
            "source_read_to_render_ms",
            "source_read_to_render_slope_ms_per_minute",
            "source_read_to_display_submit_ms",
            "sensor_to_photon_ms",
            "frame_processing_to_render_ms",
            "rss_mib",
            "rss_delta_mib",
            "rss_slope_mib_per_minute",
            "latency_continuous_growth_flag",
            "rss_continuous_growth_flag",
            "processed_frame_count",
            "dropped_capture_frame_count",
            "degraded_frame_rate",
            "retained_source_read_to_render_sample_count",
            "retained_source_read_to_display_submit_sample_count",
            "color_name_accuracy",
            "color_name_evaluated_count",
            "lighting_name_stability_rate",
            "segmentation_iou",
            "segmentation_adequacy_rating",
            "segmentation_adequate_rate",
            "delta_e_original",
            "delta_e_cvd",
            "risk_score",
            "risk_sanity_order_pass",
            "outside_recolor_mask_changed_pixel_count",
            "temporal_assistive_color_switch_count",
            "analysis_frame_id_mismatch_count",
            "artifact_checksum_mismatch_count",
            "unconsented_tracked_media_count",
            "manual_baseline_completion_seconds"
          ]
        },
        "aggregation": {
          "enum": [
            "single", "p50", "p95", "slope", "start", "end", "peak",
            "count", "overall", "per_class", "per_lighting", "per_category",
            "mean", "median", "whole_session", "steady_state", "window_median"
          ]
        },
        "unit": {
          "enum": [
            "ms", "ms/min", "frames/s", "MiB", "MiB/min", "frame", "count", "ratio",
            "pixel", "delta_e_00", "score_0_1", "rating_0_3", "boolean", "second"
          ]
        },
        "status": {"enum": ["MEASURED", "NOT_MEASURED", "NOT_APPLICABLE"]},
        "value": {"type": ["number", "integer", "boolean", "null"]},
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z0-9-]+$"}
        },
        "threshold_id": {"type": ["string", "null"]},
        "threshold_result": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE", "NOT_EVALUATED"]},
        "reason": {"type": "string"},
        "method": {"type": "string", "minLength": 1},
        "dimensions": {
          "type": "object",
          "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "MEASURED"}}},
          "then": {"properties": {"value": {"type": ["number", "integer", "boolean"]}}},
          "else": {
            "properties": {
              "value": {"type": "null"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {"const": "sensor_to_photon_ms"},
              "status": {"const": "MEASURED"}
            },
            "required": ["name", "status"]
          },
          "then": {
            "properties": {
              "method": {"type": "string", "pattern": "(external|External|photodiode|high-speed)"}
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "case_ids",
        "relative_path",
        "sha256",
        "byte_size",
        "media_type",
        "tracked_in_git",
        "derived_from",
        "generation_command",
        "provenance"
      ],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z0-9-]+$"}
        },
        "relative_path": {"type": "string", "pattern": "^[^\\\\]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_size": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1},
        "tracked_in_git": {"type": "boolean"},
        "derived_from": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
        },
        "generation_command": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "allOf": [
        {
          "if": {"properties": {"tracked_in_git": {"const": true}}},
          "then": {
            "properties": {
              "relative_path": {"pattern": "^evaluation/results/curated/.+\\.(csv|json|md)$"},
              "media_type": {"enum": ["text/csv", "application/json", "text/markdown"]},
              "byte_size": {"maximum": 1048576},
              "provenance": {
                "allOf": [
                  {"properties": {"contains_personal_data": {"const": false}}}
                ]
              }
            }
          },
          "else": {"properties": {"relative_path": {"pattern": "^artifacts/t09/"}}}
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_class",
        "creator_or_source",
        "source_url",
        "created_or_captured_at_utc",
        "license_id",
        "license_evidence",
        "consent_status",
        "consent_record_ref",
        "contains_personal_data"
      ],
      "properties": {
        "provenance_class": {"enum": ["project_synthetic", "project_capture", "public_fixture", "derived_artifact", "curated_result"]},
        "creator_or_source": {"type": "string", "minLength": 1},
        "source_url": {"type": ["string", "null"], "format": "uri"},
        "created_or_captured_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "license_id": {"type": "string", "minLength": 1},
        "license_evidence": {"type": "string", "minLength": 1},
        "consent_status": {
          "enum": [
            "NOT_APPLICABLE_NO_PERSON",
            "PUBLIC_LICENSED",
            "EXPLICIT_WRITTEN_CONSENT_PRIVATE_RECORD"
          ]
        },
        "consent_record_ref": {"type": ["string", "null"]},
        "contains_personal_data": {"type": "boolean"}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "started_at_utc", "ended_at_utc"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "exit_code": {"type": "integer"},
        "started_at_utc": {"type": "string", "format": "date-time"},
        "ended_at_utc": {"type": "string", "format": "date-time"},
        "output_summary": {"type": "string"}
      }
    },
    "failure_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_id", "case_ids", "observed_behavior", "expected_behavior", "user_impact", "reproduction", "mitigation", "status"],
      "properties": {
        "failure_id": {"type": "string", "pattern": "^FAIL-[A-Z0-9-]+$"},
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[A-Z0-9-]+$"}
        },
        "observed_behavior": {"type": "string", "minLength": 1},
        "expected_behavior": {"type": "string", "minLength": 1},
        "user_impact": {"type": "string", "minLength": 1},
        "reproduction": {"type": "string", "minLength": 1},
        "mitigation": {"type": "string", "minLength": 1},
        "status": {"enum": ["OPEN", "MITIGATED", "ACCEPTED_LIMITATION", "FIXED"]}
      }
    },
    "responsible_ai": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_local_offline",
        "frames_saved_by_default",
        "frames_uploaded_by_default",
        "medical_diagnosis_claim",
        "user_selected_profile",
        "privacy_summary",
        "bias_coverage_summary",
        "environmental_summary",
        "license_summary",
        "user_validation_status"
      ],
      "properties": {
        "runtime_local_offline": {"type": "boolean"},
        "frames_saved_by_default": {"const": false},
        "frames_uploaded_by_default": {"const": false},
        "medical_diagnosis_claim": {"const": false},
        "user_selected_profile": {"const": true},
        "privacy_summary": {"type": "string", "minLength": 1},
        "bias_coverage_summary": {"type": "string", "minLength": 1},
        "environmental_summary": {"type": "string", "minLength": 1},
        "license_summary": {"type": "string", "minLength": 1},
        "user_validation_status": {"enum": ["NOT_MEASURED", "PARTIAL", "MEASURED"]}
      }
    }
  }
}
